<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @feature Android port material3-glass-ui 20/10/2026 Glass
     panel behind the plain android.app.AlertDialogs the launcher still
     uses (language picker, render-backend picker, clear-logs confirm):
     translucent navy glass fill, hairline glass stroke, 28dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#E61B2C4A"
        android:endColor="#E60D1830" />
    <stroke
        android:width="1dp"
        android:color="@color/gzh_glass_stroke" />
    <corners android:radius="28dp" />
</shape>
