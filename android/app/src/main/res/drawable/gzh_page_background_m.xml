<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @feature Android port tactical-command-ui 20/10/2026
     Tactical Command backdrop for every launcher page: a dark
     olive-charcoal base gradient, a soft signal-amber radial glow
     bleeding from the top corner (a console light, not the old cyan
     glass glow), and the faint blueprint grid of @drawable/gzh_bg_grid_m
     laid over everything. Flat shapes only — no blur, no translucency
     glass — identical on API 28+. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: dark olive, lighter at the top. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/gzhm_gradient_start"
                android:centerColor="@color/gzhm_gradient_mid"
                android:endColor="@color/gzhm_gradient_end" />
        </shape>
    </item>
    <!-- Amber glow, top end corner. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.88"
                android:centerY="0.02"
                android:startColor="#2E8FA8C8"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Blueprint grid over the whole page. -->
    <item
        android:drawable="@drawable/gzh_bg_grid_m"
        android:gravity="fill" />
</layer-list>
