<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port material3-glass-ui 20/10/2026 One
         spacing/shape scale for every launcher screen, retuned for the
         glass redesign: more air (20dp gutter, 22dp card padding), larger
         radii and type. All existing names kept. Read from UiKit.java. -->

    <!-- Page gutter: distance from the screen edge to any card. -->
    <dimen name="gzh_gutter">20dp</dimen>
    <!-- Gap between two cards. -->
    <dimen name="gzh_card_gap">14dp</dimen>
    <!-- Padding inside a card. -->
    <dimen name="gzh_card_padding">22dp</dimen>
    <!-- Gap between two items inside a card. -->
    <dimen name="gzh_item_gap">14dp</dimen>
    <dimen name="gzh_item_gap_tight">8dp</dimen>

    <dimen name="gzh_radius_card">28dp</dimen>
    <dimen name="gzh_radius_row">20dp</dimen>
    <dimen name="gzh_radius_field">18dp</dimen>

    <dimen name="gzh_button_height">56dp</dimen>
    <dimen name="gzh_icon">22dp</dimen>
    <dimen name="gzh_icon_button">48dp</dimen>

    <dimen name="gzh_text_display">32sp</dimen>
    <dimen name="gzh_text_title">18sp</dimen>
    <dimen name="gzh_text_body">15sp</dimen>
    <dimen name="gzh_text_caption">12sp</dimen>
    <dimen name="gzh_text_overline">12sp</dimen>
</resources>
