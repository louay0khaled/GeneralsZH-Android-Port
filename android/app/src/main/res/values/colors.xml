    <color name="gzh_on_secondary">#1E2413</color>
    <color name="gzh_secondary_container">#2F3821</color>
    <color name="gzh_on_secondary_container">#DAE4C6</color>

    <!-- Tertiary: alert red, sparingly — destructive / "clear" actions. -->
