<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port tactical-command-ui 20/10/2026 Design
         tokens for the launcher (Setup / GeneralsOnline / Log Viewer /
         Folder Picker / ReplayCheck / NetworkDiagnostics).

         TACTICAL COMMAND identity — a military command-console HUD in the
         spirit of the game itself, replacing the previous navy/cyan glass
         look wholesale: near-black charcoal/olive grounds, dark olive-grey
         panels with hard khaki hairline borders, SHARP corners (see
         dimens.xml: 3-4dp radii), a signal-amber primary, a tactical
         olive/khaki secondary, and alert red kept for destructive/status
         use only. Every pre-existing gzh_* name is kept (Java and
         themes.xml reference them) with retuned values; the old glass
         token names now resolve to flat tactical fills/strokes, so no
         call site had to change.

         GeneralsZHActivity (the game surface itself) never references any
         of these — it stays on its own plain fullscreen theme. -->

    <!-- Ground + surface ladder (dark olive-charcoal) -->
    <color name="gzh_background">#0C0E0A</color>
    <color name="gzh_surface">#12140F</color>
    <color name="gzh_surface_container_low">#161810</color>
    <color name="gzh_surface_container">#1A1D16</color>
    <color name="gzh_surface_container_high">#22261C</color>
    <color name="gzh_surface_container_highest">#2E3324</color>

    <!-- Content on those surfaces. gzh_on_surface / _variant / _faint all
         clear WCAG AA (4.5:1) against gzh_surface_container (#1A1D16):
         approx. 14.1:1, 9.9:1 and 6.9:1 respectively. -->
    <color name="gzh_on_surface">#EDEAE0</color>
    <color name="gzh_on_surface_variant">#CBC5B2</color>
    <color name="gzh_on_surface_faint">#ABA48F</color>
    <color name="gzh_outline">#6E7357</color>
    <color name="gzh_outline_variant">#3B3F2F</color>

    <!-- Primary: signal amber — headings' ticks, active nav block, selected
         segment, the hero launch block. Text on it is near-black. -->
    <color name="gzh_primary">#FFB300</color>
    <color name="gzh_on_primary">#1D1400</color>
    <color name="gzh_primary_container">#4A3808</color>
    <color name="gzh_on_primary_container">#FFD97A</color>
    <!-- Kept for the themes.xml colorPrimaryDark slot. -->
    <color name="gzh_primary_dark">#0C0E0A</color>
    <color name="gzh_accent">#FFB300</color>

    <!-- Secondary: tactical olive/khaki — tonal chips/containers, icons. -->
    <color name="gzh_secondary">#A3B18A</color>
    <color name="gzh_on_secondary">#1E2413</color>
    <color name="gzh_secondary_container">#2F3821</color>
    <color name="gzh_on_secondary_container">#DAE4C6</color>

    <!-- Tertiary: alert red, sparingly — destructive / "clear" actions. -->
    <color name="gzh_tertiary">#E4572E</color>
    <color name="gzh_on_tertiary">#2E0D02</color>
    <color name="gzh_tertiary_container">#5C2812</color>
    <color name="gzh_on_tertiary_container">#FFD9C7</color>

    <color name="gzh_error">#FFB59D</color>
    <color name="gzh_on_error">#621B00</color>
    <color name="gzh_error_container">#7A2712</color>
    <color name="gzh_on_error_container">#FFDAD0</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#61EDEAE0</color>
    <color name="gzh_container_disabled">#1FEDEAE0</color>
    <color name="gzh_ripple_light">#1FEDEAE0</color>
    <color name="gzh_ripple_primary">#33FFB300</color>

    <!-- Semantic status colours, legible on the dark olive ground. -->
    <color name="gzh_status_ok">#8FC97A</color>
    <color name="gzh_status_warn">#FFB300</color>
    <color name="gzh_status_error">#FF7A52</color>

    <!-- Legacy glass token names (kept: UiKit, LogViewerActivity and
         NetworkDiagnosticsActivity reference them). Under Tactical Command
         they are FLAT tactical values — solid panel fills and khaki
         hairline strokes. No translucency-blur look anywhere. -->
    <color name="gzh_glass_fill">#23271B</color>
    <color name="gzh_glass_fill_high">#2C3122</color>
    <color name="gzh_glass_fill_low">#14160F</color>
    <color name="gzh_glass_surface">#F21A1D16</color>
    <color name="gzh_glass_surface_high">#F222261C</color>
    <color name="gzh_glass_stroke">#4B5040</color>
    <color name="gzh_glass_stroke_strong">#7D6C33</color>
    <color name="gzh_glass_highlight">#12FFFFFF</color>
    <color name="gzh_glass_nav">#FA0C0E0A</color>
    <color name="gzh_glass_scrim">#99050703</color>

    <!-- Page-background gradient stops (dark olive, top-lit). The old
         teal/cyan/violet glow names are kept for compatibility and now
         resolve into the amber/olive family. -->
    <color name="gzh_gradient_start">#15170F</color>
    <color name="gzh_gradient_mid">#0F110C</color>
    <color name="gzh_gradient_end">#0A0C08</color>
    <color name="gzh_glow_teal">#FFB300</color>
    <color name="gzh_glow_cyan">#A3B18A</color>
    <color name="gzh_glow_violet">#3B3F2F</color>
    <color name="gzh_glow_gold">#FFB300</color>
    <color name="gzh_accent_gold">#FFB300</color>

    <!-- Tactical Command additions. -->
    <color name="gzh_amber">#FFB300</color>
    <color name="gzh_amber_dim">#59FFB300</color>
    <color name="gzh_khaki">#9BA657</color>
    <color name="gzh_grid_line">#14EDEAE0</color>
    <color name="gzh_hero_start">#1D2016</color>
    <color name="gzh_hero_end">#11130C</color>
</resources>
