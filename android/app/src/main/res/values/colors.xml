<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port material3-glass-ui 20/10/2026 Design
         tokens for the launcher (Setup / GeneralsOnline / Log Viewer /
         Folder Picker / ReplayCheck / NetworkDiagnostics).

         Deep-navy glass palette: a very dark navy ground (reached through
         @drawable/gzh_page_background, a layered gradient), translucent
         white/navy glass fills with hairline strokes floating on top of it,
         a vibrant cyan-teal primary (futuristic-military, fits an RTS) and
         a gold/amber secondary accent. All pre-existing gzh_* names are
         kept with retuned values so Java and themes.xml compile unchanged;
         glass/gradient/glow tokens below them are new.

         GeneralsZHActivity (the game surface itself) never references any
         of these — it stays on its own plain fullscreen theme. -->

    <!-- Ground + surface ladder (M3 surface container roles, deep navy) -->
    <color name="gzh_background">#060B1A</color>
    <color name="gzh_surface">#0A1226</color>
    <color name="gzh_surface_container_low">#0C152E</color>
    <color name="gzh_surface_container">#101B36</color>
    <color name="gzh_surface_container_high">#182747</color>
    <color name="gzh_surface_container_highest">#22335C</color>

    <!-- Content on those surfaces. gzh_on_surface / _variant / _faint all
         clear WCAG AA (4.5:1) against gzh_surface_container (#101B36):
         approx. 14.9:1, 8.7:1 and 6.8:1 respectively. -->
    <color name="gzh_on_surface">#F2F6FF</color>
    <color name="gzh_on_surface_variant">#B8C2D9</color>
    <color name="gzh_on_surface_faint">#A8B6D3</color>
    <color name="gzh_outline">#46587E</color>
    <color name="gzh_outline_variant">#26365C</color>

    <!-- Primary: vibrant cyan-teal accent (headings, active nav item,
         selected segment, hero action). -->
    <color name="gzh_primary">#2DD4E8</color>
    <color name="gzh_on_primary">#022A33</color>
    <color name="gzh_primary_container">#10455C</color>
    <color name="gzh_on_primary_container">#C7F5FF</color>
    <!-- Kept for the themes.xml colorPrimaryDark slot. -->
    <color name="gzh_primary_dark">#060B1A</color>
    <color name="gzh_accent">#2DD4E8</color>

    <!-- Secondary: gold/amber accent — tonal chips/containers, highlights. -->
    <color name="gzh_secondary">#F2C14E</color>
    <color name="gzh_on_secondary">#332700</color>
    <color name="gzh_secondary_container">#4A3A10</color>
    <color name="gzh_on_secondary_container">#FFE9A8</color>

    <!-- Tertiary: the muted pastel used for destructive / "clear" actions. -->
    <color name="gzh_tertiary">#FFB59E</color>
    <color name="gzh_on_tertiary">#4A2517</color>
    <color name="gzh_tertiary_container">#5C3325</color>
    <color name="gzh_on_tertiary_container">#FFDAD0</color>

    <color name="gzh_error">#FFB4AB</color>
    <color name="gzh_on_error">#690005</color>
    <color name="gzh_error_container">#93000A</color>
    <color name="gzh_on_error_container">#FFDAD6</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#61F2F6FF</color>
    <color name="gzh_container_disabled">#1FF2F6FF</color>
    <color name="gzh_ripple_light">#1FF2F6FF</color>
    <color name="gzh_ripple_primary">#332DD4E8</color>

    <!-- Semantic status colours, legible on the navy ground. -->
    <color name="gzh_status_ok">#4ADE80</color>
    <color name="gzh_status_warn">#F2C14E</color>
    <color name="gzh_status_error">#FFB4AB</color>

    <!-- Glassmorphism tokens (new). Glass is simulated with translucency,
         gradient and stroke — no RenderEffect blur, so API 28-30 are safe. -->
    <color name="gzh_glass_fill">#2EFFFFFF</color>
    <color name="gzh_glass_fill_high">#3DFFFFFF</color>
    <color name="gzh_glass_fill_low">#1AFFFFFF</color>
    <color name="gzh_glass_surface">#CC0D1830</color>
    <color name="gzh_glass_surface_high">#D9162747</color>
    <color name="gzh_glass_stroke">#33FFFFFF</color>
    <color name="gzh_glass_stroke_strong">#59FFFFFF</color>
    <color name="gzh_glass_highlight">#1FFFFFFF</color>
    <color name="gzh_glass_nav">#D9081122</color>
    <color name="gzh_glass_scrim">#99040912</color>

    <!-- Gradient / glow accents for the page background and primary fills. -->
    <color name="gzh_gradient_start">#0A1834</color>
    <color name="gzh_gradient_mid">#081226</color>
    <color name="gzh_gradient_end">#04060F</color>
    <color name="gzh_glow_teal">#2DD4E8</color>
    <color name="gzh_glow_cyan">#38BDF8</color>
    <color name="gzh_glow_violet">#8B7CFF</color>
    <color name="gzh_glow_gold">#F2C14E</color>
    <color name="gzh_accent_gold">#F2C14E</color>
</resources>
